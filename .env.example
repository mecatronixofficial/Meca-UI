# Copy to .env.local and fill in what you need.
# Anything left blank falls back to the defaults in src/config/envConfig.ts.

# ---------------------------------------------------------------------------
# Server-only secrets (never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Powers the MECA chat assistant (src/app/api/meca/route.ts).
# Without it the chat replies "MECA is not configured".
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/mec-api
NEXT_PUBLIC_WS_URL=http://localhost:5000
NEXT_PUBLIC_API_TIMEOUT=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Mecatronix
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_APP_SLOGAN=
NEXT_PUBLIC_COMPANY_NAME=Mecatronix
# development | staging | production (non-production shows a marker on the loading screen)
NEXT_PUBLIC_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Contact (also used in SEO structured data)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIMARY_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Location & business hours (used in SEO structured data)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_FULL_ADDRESS=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_STATE=
NEXT_PUBLIC_COMPANY_COUNTRY=
NEXT_PUBLIC_COMPANY_PINCODE=
NEXT_PUBLIC_GOOGLE_MAPS_LINK=
# e.g. Mon-Sat, 10:00, 19:00
NEXT_PUBLIC_BUSINESS_DAYS=
NEXT_PUBLIC_BUSINESS_HOURS_START=
NEXT_PUBLIC_BUSINESS_HOURS_END=
NEXT_PUBLIC_EMERGENCY_SUPPORT_24x7=false

# ---------------------------------------------------------------------------
# Social profiles (set ones you have; they appear in the footer, contact page
# and the Organization "sameAs" SEO data)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61586332485916
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mecatronixofficial/
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@Mecatronixsoftwaredevelopment
NEXT_PUBLIC_GITHUB_URL=

# ---------------------------------------------------------------------------
# Localization
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,hi,ta
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_DATE_FORMAT=DD/MM/YYYY

# ---------------------------------------------------------------------------
# Feature flags / debug
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_REAL_TIME_MONITORING=false
NEXT_PUBLIC_ENABLE_MACHINE_CONTROLS=false
NEXT_PUBLIC_ENABLE_DATA_ANALYTICS=false
NEXT_PUBLIC_DEFAULT_REFRESH_RATE=
NEXT_PUBLIC_MACHINE_STATUS_POLLING=
NEXT_PUBLIC_MAX_CONCURRENT_MACHINES=
